---
import '@fontsource-variable/newsreader/standard.css';
import '@fontsource-variable/newsreader/standard-italic.css';
import '@fontsource-variable/playwrite-ie';
import '../styles/publisher.css';
import '../styles/harmony.css';
import DrawnArt from '../components/DrawnArt.astro';
import BrandName from '../components/BrandName.astro';
import { cloudflareWebAnalyticsToken } from '../../../../site.config.mjs';
const isPreview = import.meta.env.BASE_URL.startsWith('/publisher');
const { title = 'Scale of Us — Stories at the human scale', description = 'Stories about being human in the age of AI. In print, online, and in immersive reading.', active = '' } = Astro.props;
---
<!doctype html>
<html lang="en" data-palette="pink">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {isPreview && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={new URL(Astro.url.pathname.replace(/^\/publisher(?=\/|$)/, "" ) || "/", "https://scaleofus.com")} />
    {cloudflareWebAnalyticsToken && <script type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({token:cloudflareWebAnalyticsToken})}></script>}
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fff5f9" />
    <link rel="icon" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header wrap">
      <div class="publisher-identity"><a class="wordmark brand" href="/" aria-label="Scale of Us home"><DrawnArt name="n30" class="brand-scene" eager /><BrandName /></a><p class="publisher-description">Stories about being human in the <span class="statement-ending">age of AI.</span></p></div>
      <nav aria-label="Main navigation">
        <a href="/about/" aria-current={active === 'about' ? 'page' : undefined}>About</a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="footer-landscape">
        <svg class="footer-horizon" viewBox="0 0 1440 320" preserveAspectRatio="none" aria-hidden="true">
          <path class="horizon-ground" d="M0 145 C125 150 180 112 300 106 C450 94 510 168 690 154 C870 142 1010 100 1140 124 C1260 147 1350 145 1440 134 L1440 320 L0 320 Z" />
        </svg>
        <div class="footer-world wrap"><p>A little world.<br /><em>Room to grow.</em></p><DrawnArt name="n51" class="footer-town" /></div>
      </div>
      <div class="wrap footer-top"><div><a class="wordmark brand" href="/" aria-label="Scale of Us home"><DrawnArt name="n30" class="brand-scene" /><BrandName /></a><p>Stories about what it means to be human.</p></div><nav class="footer-links" aria-label="Footer"><a href="/about/" aria-current={active === "about" ? "page" : undefined}>About</a></nav></div>
      <div class="wrap footer-bottom"><span>© 2026 Scale of Us</span>{isPreview && <span>Publisher preview</span>}</div>
    </footer>
    {isPreview && <details class="preview-tools"><summary aria-label="Compare pastel colour palettes">Colours</summary><div class="preview-tool-panel"><p>DESIGN PREVIEW · 10</p><div class="palette-picker" role="group" aria-label="Preview pastel palettes"><button type="button" data-palette="sky" aria-pressed="false" aria-label="Pale blue palette"><span></span>Sky</button><button type="button" data-palette="pink" aria-pressed="true" aria-label="Blush pink palette"><span></span>Pink</button><button type="button" data-palette="lilac" aria-pressed="false" aria-label="Soft lilac palette"><span></span>Lilac</button></div></div></details>}
  </body>
</html>
<script>
  import '../scripts/drawings';
  const paletteButtons = [...document.querySelectorAll<HTMLButtonElement>('button[data-palette]')];
  function applyPalette(value: string) {
    document.documentElement.dataset.palette = value;
    paletteButtons.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.palette === value)));
  }
  // These controls compare local design proposals; no preference is transmitted.
  try { applyPalette(sessionStorage.getItem('publisher-palette') || 'pink'); } catch { applyPalette('pink'); }
  paletteButtons.forEach(button => button.addEventListener('click', () => {
    applyPalette(button.dataset.palette!);
    try { sessionStorage.setItem('publisher-palette', button.dataset.palette!); } catch { /* Palette still works without storage. */ }
  }));
</script>

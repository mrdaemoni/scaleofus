---
import Publisher from '../layouts/Publisher.astro';
import { windEdition } from '../data/edition';
---
<Publisher title="Press & review copies — Scale of Us"><section class="page-intro wrap"><p class="eyebrow">FOR REVIEWERS, LIBRARIANS, AND THE PRESS</p><h1>The stories,<br /><em>at a glance.</em></h1><p>Edition information and reading links in one place.</p></section><div class="prose-layout wrap"><aside><a href="#book">The first book</a><a href="#materials">Review materials</a><a href="#contact">Review copies & rights</a></aside><article><section id="book"><h2>The Boy Who Tried<br />to Catch the Wind</h2><p>A story about a boy, a machine, and the part of us no answer can hold.</p><dl class="spec-list"><div><dt>Creator</dt><dd>Hector Ouilhet Olmos</dd></div><div><dt>Publisher</dt><dd>Scale of Us</dd></div><div><dt>Formats</dt><dd>Printed hardcover, online reading, immersive reading</dd></div><div><dt>First printing</dt><dd>100 copies</dd></div><div><dt>Digital languages</dt><dd>English and Spanish</dd></div><div><dt>Print language</dt><dd>English</dd></div>{windEdition.details.filter(([label]) => ['Dimensions','Pages','Cover','Cover & spine','Paper','Endpapers','Bookmark'].includes(label)).map(([label,value]) => <div><dt>{label}</dt><dd>{value}</dd></div>) }</dl><p class="local-notice">Before publication of this press page: confirm ISBN, print publication date, retail price, age/readership positioning, and contact details. No award recognition is claimed.</p></section><section id="materials"><h2>See the work.</h2><ul><li><a href="/stories/the-boy-who-tried-to-catch-the-wind/">The book, photographs, and sample spread</a></li><li><a href="/read/wind/#story">Read the complete English story</a></li><li><a href="/read/es/#story">Read the complete Spanish story</a></li><li><a href="/immerse/wind/">Open the immersive edition, then press Listen</a></li><li><a href="/press/book-information.txt" download>Download the draft book information sheet</a></li></ul><p class="local-notice">The information sheet is marked as a draft. Approved high-resolution images, a portrait, a review PDF, captions, and reproduction permissions will form the launch press kit.</p></section><section id="contact"><h2>Review copies & rights.</h2><p>We’ll reserve physical copies for reviewers and award submissions before allocating the rest for gifts and sale. A publisher contact address will be added before launch.</p></section></article></div></Publisher>

---
import Publisher from '../../layouts/Publisher.astro';
import ReviewForm from '../../components/ReviewForm.astro';
import DrawnArt from '../../components/DrawnArt.astro';
import StoryFeature from '../../components/StoryFeature.astro';
import StoryShelf from '../../components/StoryShelf.astro';
import HandShape from '../../components/HandShape.astro';
import { stories, linkedInPost } from '../../data/stories';
import { windEdition } from '../../data/edition';
export function getStaticPaths() { return stories.map(story => ({params: {slug: story.slug}, props: {story}})); }
const { story } = Astro.props;
const available = story.status === 'available';

---
<Publisher title={`${story.title} — Scale of Us`} active="stories">
  <div class="wrap breadcrumb"><a href="/stories/">The stories</a><span aria-hidden="true">↗</span><span>Story {story.number}</span></div>
  {available ? <>
    <section class="first-book wrap" id="first-story"><header class="release-heading"><p class="eyebrow">STORY 01 · NOW IN PRINT</p><h1><DrawnArt name="n00" class="title-wind" eager />{story.title}</h1><p class="story-intro">A story about a boy, a machine, and the part of us no answer can hold.</p></header><StoryFeature purchaseHere /></section>
    <section class="inside-story wrap" id="story-about">
      <div class="sample-copy"><p class="eyebrow">INSIDE THE STORY</p><h2>Who are you,<br /><em>beyond your card?</em></h2><p>At school, the boy gets a card. Every word is true, but something is missing. He brings his question to a machine that knows everything anyone has written down.</p><details class="sample-pages" id="excerpt"><summary>Read the opening <span aria-hidden="true">＋</span></summary><blockquote>Once there was a boy who tried to catch the wind. Every morning, before school, the boy raced up the little hill to try to catch the wind. He could feel it in his hair and on his face. But his hands always closed on nothing. He didn’t mind. The game began every day.</blockquote><a class="text-link" href="/read/wind/#story">Keep reading →</a></details></div>
      <figure class="organic-photo inside-photo"><HandShape /><img src="/edition/detail.webp" alt="A closer look at an illustrated page from the printed story" width="1600" height="1200" loading="lazy" /></figure>
    </section>
    <section class="edition-section wrap" id="edition"><HandShape /><DrawnArt name="icon-book" class="edition-art" /><div class="edition-copy"><p class="eyebrow">THE PRINTED EDITION</p><h2>A story you can hold.</h2><p>Blue Allure cloth, matte gold foil on the cover and spine, printed endpapers, and an old-gold ribbon bookmark. Inside, the story and its hand-drawn illustrations are printed in full colour on natural-toned paper.</p><details class="edition-details"><summary>Book details <span aria-hidden="true">＋</span></summary><dl class="spec-list">{windEdition.details.map(([label,value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl><p class="subtle">ISBN and publication date will be confirmed before sales open.</p><a class="text-link" href="/about/#creator">Meet the author ↗</a></details></div></section>
    <section class="reviews-section wrap" id="reviews"><div class="section-heading"><div><p class="eyebrow">IN READERS’ WORDS</p><h2>What stayed with you?</h2></div><DrawnArt name="n06" crop="-720 1580 535 505" class="review-machine" /></div><div class="review-tabs" role="group" aria-label="Review categories"><button type="button" data-review-tab="print" aria-pressed="true">Printed edition</button><button type="button" data-review-tab="digital" aria-pressed="false">Digital story</button></div><div data-review-panel="print"><p class="review-empty">Read the book? Share what stayed with you.</p><p class="subtle review-status">Printed reviews have yet to be added to this preview.</p><ReviewForm slug={story.slug} /></div><div data-review-panel="digital" hidden><p>Readers have shared their responses to the digital story on LinkedIn.</p><a class="text-link" href={linkedInPost} target="_blank" rel="noopener noreferrer">The original conversation ↗</a></div></section>
    <section class="next-stories wrap"><p class="eyebrow">THE SERIES CONTINUES</p><StoryShelf upcomingOnly /></section>
  </> : <>
    <section class="forthcoming-hero wrap"><div><p class="eyebrow">STORY {story.number} · FORTHCOMING</p><h1>{story.title}</h1><p class="book-dek">The boy’s story continues.</p><p>Planned for print, online reading, and immersive reading.</p><p class="subtle">More to share when the story is ready.</p><a class="text-link" href="/stories/the-boy-who-tried-to-catch-the-wind/">Discover the first story →</a></div><div class={`forthcoming-art ${story.color}`}><HandShape variant="cloud" /><p>{story.subject}</p><DrawnArt name="n00" class="forthcoming-wind" /><small>Story {story.number} · Coming next</small></div></section>
  </>}
</Publisher>
<script>
  document.querySelector('[data-purchase-preview]')?.addEventListener('click', () => { document.querySelector<HTMLElement>('.purchase-message')!.hidden = false; });
  document.querySelectorAll<HTMLButtonElement>('[data-review-tab]').forEach(button => button.addEventListener('click', () => {
    document.querySelectorAll('[data-review-tab]').forEach(item => item.setAttribute('aria-pressed', String(item === button)));
    document.querySelectorAll<HTMLElement>('[data-review-panel]').forEach(panel => { panel.hidden = panel.dataset.reviewPanel !== button.dataset.reviewTab; });
  }));
</script>

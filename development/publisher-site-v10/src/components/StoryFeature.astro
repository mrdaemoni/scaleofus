---
import BookGallery from './BookGallery.astro';
import '../styles/reflections.css';
import DrawnArt from './DrawnArt.astro';
import PurchaseButton from './PurchaseButton.astro';
import { windSlug } from '../data/stories';
import { windEdition } from '../data/edition';
import checkout from '../../../../src/content/checkout.public.json';
const { purchaseHere = false } = Astro.props;
const checkoutReview = process.env.CHECKOUT_REVIEW === '1';
---
<div class="story-feature" data-story-feature>
  <nav class="story-format-actions" aria-label="Choose a story format"><div class="story-tabs">
    <a class="book-entry" id="book-tab" href="#book-panel" aria-current="location"><DrawnArt name="icon-book" class="tab-art" /><span>Book</span><svg class="tab-stroke" viewBox="0 0 120 10" aria-hidden="true"><path d="M3 8 L19 3 Q60 0 115 2" /></svg></a>
    <a id="digital-tab" class="reader-entry" href="/immerse/wind/" lang="en" aria-label="Read or listen online"><DrawnArt name="icon-play" class="tab-art" /><span>Read or listen<span class="entry-label-detail"> online</span></span></a>
  </div>
    <a class="spanish-reader-link reader-entry" href="/immerse/es/" lang="es" aria-label="Lee o escucha en línea"><DrawnArt name="icon-play" class="tab-art" /><span>Lee o escucha<span class="entry-label-detail"> en línea</span></span></a>
  </nav>
  <div class="feature-panels">
    <div class="feature-panel is-preview-active" role="region" id="book-panel" aria-label="Printed book" tabindex="-1" data-format-panel="print">
      <div class="feature-preview"><BookGallery eager /></div>
      <div class="feature-details">
        <div class="book-description">{windEdition.description.map(paragraph => <p>{paragraph}</p>)}</div>
        <div id={purchaseHere ? 'purchase' : undefined}><div class="purchase-actions"><PurchaseButton href={checkout.enabled ? '/order/' : checkoutReview ? '/order/review/' : (purchaseHere ? undefined : `/stories/${windSlug}/#purchase`)} data-purchase-preview={purchaseHere && !checkoutReview && !checkout.enabled ? '' : undefined}>{checkoutReview && !checkout.enabled ? 'Preview an order' : 'Buy the book'}</PurchaseButton>
          <a class="purchase-button pdf-download" href={`/books/${windSlug}/The-Boy-Who-Tried-to-Catch-the-Wind.pdf`} download="The-Boy-Who-Tried-to-Catch-the-Wind.pdf">Download the free PDF</a>
          </div>
          {purchaseHere && <><p class="subtle purchase-note">{checkout.enabled ? 'Signed hardcover · $75 + $12 US shipping per order.' : 'Signed hardcover · $75 plus shipping. Sales are not open.'}</p>{!checkout.enabled && <div class="purchase-message" role="status" hidden><strong>A copy of your own.</strong><p>The signed hardcover is $75 plus shipping. Sales are closed while checkout is prepared. This preview takes no payment.</p><a href="/help/#delivery">Purchase details →</a></div>}</>}
        </div>
      </div>
    </div>
  </div>
</div>
<a class="reflection-invitation" href="/reflections/">Tell us what stayed with you →</a>
<script>
  // Bookmarks to the removed English preview now open the full English reader.
  const englishReader = document.querySelector<HTMLAnchorElement>('#digital-tab');
  const preserveEnglishPreviewLink = () => {
    if (englishReader && ['#digital-panel', '#reading'].includes(location.hash)) {
      location.replace(englishReader.href);
    }
  };
  preserveEnglishPreviewLink();
  addEventListener('hashchange', preserveEnglishPreviewLink);
</script>

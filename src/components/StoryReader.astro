---
import Base from "../layouts/Base.astro";
import "../styles/global.css";
import { formatTime, parseStoryMarkdown } from "../lib/story";
import type { StoryBookSource } from "../lib/story-book";
import {
  storyArt,
  storyArtKind,
  storyArtMobile,
  speakerStyle,
  validateStoryWordTimings,
  validateVoicePassages,
  voiceWords,
} from "../lib/story-reader";

const { book } = Astro.props as { book: StoryBookSource };
const {
  reader: windStoryReader,
  manuscript: storyMarkdown,
  headingTimings: storyHeadingTimings,
  beatTimings: storyTimings,
  wordTimings: storyWordTimings,
} = book;
const companion = book.presentation?.companion;
const navigation = book.presentation?.navigation ?? { kind: "chapters" as const };
const locale = book.locale ?? "en";
const languageLinks = book.presentation?.languages ?? [];
const ui = {
  read: "Read",
  readAtYourPace: "At your pace",
  listen: "Listen",
  readAloud: "read aloud",
  chapter: "Chapter",
  chapters: "Chapters",
  home: "Home",
  previousChapter: "Previous chapter",
  nextChapter: "Next chapter",
  readingNavigation: "Reading navigation",
  backToBeginning: "Return to the beginning",
  scrollIntoStory: "Scroll into the story",
  drawing: "Drawing",
  drawingNeeded: "needed",
  drawingToCome: "Drawing to come",
  ...book.presentation?.ui,
};
const narrationAvailable = windStoryReader.narrationAvailable !== false;
const duration = windStoryReader.audio.duration;
const chapters = parseStoryMarkdown(storyMarkdown, duration, storyTimings);
if (narrationAvailable) {
  validateVoicePassages(chapters, windStoryReader);
  validateStoryWordTimings(chapters, storyWordTimings.beats, duration, windStoryReader);
}
const staticWordCues = (value: string, time: number) => value.trim().split(/\s+/).map(() => ({
  start: time,
  end: time,
}));
const activeCoverHeadingTiming = narrationAvailable ? storyHeadingTimings.cover : {
  start: 0,
  end: 0,
  words: staticWordCues(windStoryReader.title, 0),
};
const activeChapterHeadingTimings = narrationAvailable ? storyHeadingTimings.chapters : chapters.map((chapter) => ({
  number: chapter.number,
  transitionStart: chapter.start,
  start: chapter.start,
  end: chapter.start,
  labelWords: staticWordCues(`${ui.chapter} ${chapter.numeral}`, chapter.start),
  titleWords: staticWordCues(chapter.title, chapter.start),
}));
const headingTimingByChapter = new Map(activeChapterHeadingTimings.map((heading) => [heading.number, heading]));
if (
  headingTimingByChapter.size !== activeChapterHeadingTimings.length
  || headingTimingByChapter.size !== chapters.length
) throw new Error("Chapter heading timings must contain each story chapter exactly once.");
const timedTokens = (
  text: string,
  cues: ReadonlyArray<{ start: number; end: number }>,
  context: string,
) => {
  const tokens = text.trim().split(/\s+/);
  if (tokens.length !== cues.length) {
    throw new Error(`${context} has ${tokens.length} displayed words but ${cues.length} timing cues.`);
  }
  let previousEnd = 0;
  cues.forEach((cue, index) => {
    if (
      !Number.isFinite(cue.start)
      || !Number.isFinite(cue.end)
      || cue.start < previousEnd
      || cue.end < cue.start
      || cue.end > duration
    ) throw new Error(`${context}, cue ${index + 1} is invalid or out of order.`);
    previousEnd = cue.end;
  });
  return tokens.map((token, index) => ({ text: token, ...cues[index] }));
};
const coverHeadingWords = timedTokens(windStoryReader.title, activeCoverHeadingTiming.words, "Cover title");
const chapterHeadingWords = new Map(chapters.map((chapter) => {
  const timing = headingTimingByChapter.get(chapter.number);
  if (!timing) throw new Error(`Chapter ${chapter.number} has no heading timing.`);
  return [chapter.number, {
    label: timedTokens(`${ui.chapter} ${chapter.numeral}`, timing.labelWords, `${ui.chapter} ${chapter.number} label`),
    title: timedTokens(chapter.title, timing.titleWords, `Chapter ${chapter.number} title`),
  }];
}));
const chapterData = chapters.map(({ number, title, id, beats }) => {
  const heading = headingTimingByChapter.get(number);
  if (!heading) throw new Error(`Chapter ${number} has no heading timing.`);
  return {
    number,
    title,
    id,
    start: heading.start,
    transitionStart: heading.transitionStart,
    headingEnd: heading.end,
    firstWordStart: beats[0]?.start ?? heading.end,
  };
});
const beatData = chapters.flatMap((chapter) =>
  chapter.beats.map(({ number, start, end }) => ({ number, start, end, chapter: chapter.number })),
);
const wordTimingByBeat = new Map(
  narrationAvailable ? storyWordTimings.beats.map((beat) => [beat.number, beat] as const) : [],
);
const artForBeat = (number: number) => storyArt(windStoryReader, number);
const artKindForBeat = (number: number) => storyArtKind(windStoryReader, number);
const mobileArtForBeat = (number: number) => storyArtMobile(windStoryReader, number);
const coverBackdrop = windStoryReader.artwork.coverBackdrop;
const titleArtwork = windStoryReader.artwork.title;
const entryIcons = windStoryReader.artwork.entryIcons;
const companionTitleArtwork = windStoryReader.artwork.companionTitle;
const endArtwork = windStoryReader.artwork.end;
const experienceDescription = locale === "es"
  ? `Una experiencia inmersiva de lectura. ${windStoryReader.intro}`
  : `${narrationAvailable ? "An immersive reading and listening experience." : "An immersive reading experience."} ${windStoryReader.intro}`;
const resolvedSpeaker = (
  chapterNumber: number,
  authoredSpeaker: string,
  timedSpeaker = "narrator",
) => {
  const speaker = authoredSpeaker !== "narrator" ? authoredSpeaker : timedSpeaker;
  if (speaker !== "character") return speaker;
  return windStoryReader.chapterCharacterVoices?.[chapterNumber] ?? speaker;
};
const resolvedVoice = (
  chapterNumber: number,
  authoredSpeaker: string,
  timedSpeaker = "narrator",
) => {
  const speaker = resolvedSpeaker(chapterNumber, authoredSpeaker, timedSpeaker);
  return { speaker, style: speakerStyle(windStoryReader, speaker) };
};
const chapterStyle = (chapterNumber: number) => {
  const palette = book.presentation?.chapterPalettes?.[chapterNumber - 1];
  if (!palette) return undefined;
  return [
    `--chapter-wash:${palette.wash}`,
    `--chapter-wash-secondary:${palette.secondary}`,
    palette.paper ? `--chapter-paper:${palette.paper}` : "",
    palette.paperDeep ? `--chapter-paper-deep:${palette.paperDeep}` : "",
    palette.line ? `--chapter-line:${palette.line}` : "",
    palette.previous ? `--chapter-previous:${palette.previous}` : "",
    palette.next ? `--chapter-next:${palette.next}` : "",
  ].filter(Boolean).join(";");
};
const chapterTheme = (chapterNumber: number) =>
  book.presentation?.chapterPalettes?.[chapterNumber - 1]?.motif ?? "orbit";
---

<Base
  title={`${windStoryReader.title} — Scale of Us`}
  description={experienceDescription}
  bodyClass="story-page"
  canonicalPath={book.presentation?.canonicalPath}
  socialImage={book.presentation?.socialImage}
  socialImageWidth={book.presentation?.socialImageWidth}
  socialImageHeight={book.presentation?.socialImageHeight}
  themeColor={book.presentation?.themeColor}
  lang={locale}
  alternateLanguages={languageLinks}
>
  <div class="reading-progress" aria-hidden="true"><span data-reading-progress></span></div>

  <header class="story-nav" data-story-nav>
    <a class="wordmark" href="#top" aria-label={`Scale of Us, ${ui.backToBeginning.toLowerCase()}`} data-reader-home>
      <span>Scale</span><i>of</i><span>Us</span>
    </a>
    <nav aria-label="Story links">
      <a href="#story" data-reader-read>{ui.read}</a>
      {companion && <a href={companion.href}>{companion.navLabel}</a>}
      {languageLinks.length > 1 && (
        <span class="language-switch" aria-label="Language">
          {languageLinks.map((language) => (
            <a
              href={language.href}
              lang={language.locale}
              hreflang={language.locale}
              aria-current={language.locale === locale ? "page" : undefined}
              data-language-switch
            >{language.label}</a>
          ))}
        </span>
      )}
    </nav>
  </header>

  <main
    data-story-app
    data-reader-id={windStoryReader.id}
    data-chapters={JSON.stringify(chapterData)}
    data-beats={JSON.stringify(beatData)}
    data-reader-locale={locale}
    data-reader-chapter-label={ui.chapter}
    data-narration-available={String(narrationAvailable)}
  >
    <section class="story-cover" id="top" aria-labelledby="story-title">
      <div class="cover-vignette" aria-hidden="true"></div>
      {coverBackdrop?.kind === "live" ? (
        <div class="cover-living-wind" aria-hidden="true">
          <div
            class="living-drawing"
            data-live-drawing
            data-live-cover
            data-mobile-animate
            data-svg-src={coverBackdrop.src}
            data-raster-src={coverBackdrop.mobileSrc ?? coverBackdrop.src}
          ></div>
        </div>
      ) : (
        <div class="wind-script" aria-hidden="true">
          <i></i><i></i><i></i><i></i><i></i>
        </div>
      )}

      <div class="cover-copy">
        <h1
          id="story-title"
          class="spoken-heading visually-hidden"
          data-cover-heading
          data-heading-start={activeCoverHeadingTiming.start}
          data-heading-end={activeCoverHeadingTiming.end}
        >
          {coverHeadingWords.map((word, index) => (
            <>
              {index > 0 && " "}
              <span
                data-narration-word
                data-heading-word
                data-voice-style="narrator"
                data-start={word.start}
                data-end={word.end}
              >{word.text}</span>
            </>
          ))}
        </h1>
        {titleArtwork ? (
          <div class="cover-title-art" aria-hidden="true">
            {titleArtwork.kind === "live" ? (
              <div
                class="living-drawing"
                data-live-drawing
                data-mobile-animate
                data-svg-src={titleArtwork.src}
                data-raster-src={titleArtwork.mobileSrc ?? titleArtwork.src}
              ></div>
            ) : (
              <img src={titleArtwork.mobileSrc ?? titleArtwork.src} alt="" />
            )}
          </div>
        ) : (
          <p class="cover-title-fallback" aria-hidden="true">{windStoryReader.title}</p>
        )}
        <p class="cover-intro">{windStoryReader.intro}</p>
        <div class={`cover-story-entry ${narrationAvailable ? "" : "is-read-only"}`} role="group" aria-label={narrationAvailable ? `${ui.read} or ${ui.listen}` : ui.read}>
          <a class="entry-read" href="#story" data-reader-read>
            {entryIcons?.read ? (
              <span class="entry-art-icon" aria-hidden="true">
                <span
                  class="living-drawing"
                  data-live-drawing
                  data-svg-src={entryIcons.read.src}
                  data-raster-src={entryIcons.read.mobileSrc ?? entryIcons.read.src}
                ></span>
              </span>
            ) : <span class="round-book" aria-hidden="true"></span>}
            <span><strong>{ui.read}</strong><small>{ui.readAtYourPace}</small></span>
          </a>
          {narrationAvailable ? (
            <button class="entry-listen" type="button" data-hero-play>
              {entryIcons?.listen ? (
                <span class="entry-art-icon" aria-hidden="true">
                  <span
                    class="living-drawing"
                    data-live-drawing
                    data-svg-src={entryIcons.listen.src}
                    data-raster-src={entryIcons.listen.mobileSrc ?? entryIcons.listen.src}
                  ></span>
                </span>
              ) : <span class="round-play" aria-hidden="true">▶</span>}
              <span><strong>{ui.listen}</strong><small>{formatTime(duration)} · {ui.readAloud}</small></span>
            </button>
          ) : null}
        </div>
      </div>

      <a class="scroll-cue" href="#story" aria-label={ui.scrollIntoStory} data-reader-read><span></span></a>
    </section>

    <div class="reader-shell" id="story">
      <aside class="chapter-rail" aria-label={ui.chapters}>
        {navigation.kind === "mountain" && (
          <div class="mountain-nav-art" data-mountain-art aria-hidden="true">
            <span class="nav-cloud cloud-one"></span>
            <span class="nav-cloud cloud-two"></span>
            <span class="nav-cloud cloud-three"></span>
            <span class="nav-cloud cloud-four"></span>
            <span class="nav-cloud cloud-five"></span>
            <span class="nav-cloud cloud-six"></span>
            <span class="mountain-face"></span>
            <span class="mountain-climber" data-mountain-climber>
              <i></i>
              <b class="climber-arm arm-left"></b>
              <b class="climber-arm arm-right"></b>
            </span>
          </div>
        )}
        <a class="rail-home" href="#top" data-reader-home>
          {navigation.homeLabel ?? windStoryReader.title}
        </a>
        <ol>
          {chapters.map((chapter) => (
            <li>
              <a
                href={`#${chapter.id}`}
                data-chapter-link
                data-chapter-index={chapter.number - 1}
                data-start={headingTimingByChapter.get(chapter.number)?.start ?? chapter.start}
              >
                <span>{chapter.numeral}</span>
                <em>{chapter.shortTitle}</em>
              </a>
            </li>
          ))}
        </ol>
      </aside>

      <div class="story-flow">
        {chapters.map((chapter) => {
          const chapterArtwork = windStoryReader.artwork.chapterSources?.[chapter.number];
          return (
          <section
            class={`story-chapter chapter-${chapter.number}`}
            id={chapter.id}
            data-chapter={chapter.number}
            data-chapter-theme={chapterTheme(chapter.number)}
            data-start={headingTimingByChapter.get(chapter.number)?.start ?? chapter.start}
            aria-labelledby={`${chapter.id}-title`}
            style={chapterStyle(chapter.number)}
          >
            <header
              class="chapter-heading"
              data-chapter-heading
              data-heading-index={chapter.number - 1}
              data-transition-start={headingTimingByChapter.get(chapter.number)!.transitionStart}
              data-heading-start={headingTimingByChapter.get(chapter.number)!.start}
              data-heading-end={headingTimingByChapter.get(chapter.number)!.end}
            >
              <p class="spoken-heading visually-hidden">
                {chapterHeadingWords.get(chapter.number)!.label.map((word, index) => (
                  <>
                    {index > 0 && " "}
                    <span
                      data-narration-word
                      data-heading-word
                      data-voice-style="narrator"
                      data-start={word.start}
                      data-end={word.end}
                    >{word.text}</span>
                  </>
                ))}
              </p>
              <h2 id={`${chapter.id}-title`} class="spoken-heading visually-hidden">
                {chapterHeadingWords.get(chapter.number)!.title.map((word, index) => (
                  <>
                    {index > 0 && " "}
                    <span
                      data-narration-word
                      data-heading-word
                      data-voice-style="narrator"
                      data-start={word.start}
                      data-end={word.end}
                    >{word.text}</span>
                  </>
                ))}
              </h2>
              {chapterArtwork && (
                <div class="chapter-cover-art" aria-hidden="true">
                  {chapterArtwork.kind === "live" ? (
                    <div
                      class="living-drawing"
                      data-live-drawing
                      data-mobile-animate
                      data-svg-src={chapterArtwork.src}
                      data-raster-src={chapterArtwork.mobileSrc ?? chapterArtwork.src}
                    ></div>
                  ) : (
                    <img
                      src={chapterArtwork.mobileSrc ?? chapterArtwork.src}
                      alt=""
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                </div>
              )}
              {!chapterArtwork && (
                <div class="chapter-title-fallback" aria-hidden="true">
                  <span>{ui.chapter} {chapter.numeral}</span>
                  <strong>{chapter.title}</strong>
                </div>
              )}
              <div class={`chapter-mark mark-${chapter.number}`} aria-hidden="true">
                <i></i><i></i><i></i>
              </div>
            </header>

            <div class="chapter-beats">
              {chapter.beats.map((beat, beatIndex) => {
                const alignedBeat = wordTimingByBeat.get(beat.number);
                const passages = narrationAvailable
                  ? windStoryReader.voices.filter((passage) => passage.beat === beat.number)
                  : [];
                const words = beat.paragraphs.flatMap((paragraph) => voiceWords(paragraph, passages));
                const alignedWords = alignedBeat?.paragraphs.flatMap((paragraph) => paragraph.words) ?? [];
                const paragraphStart = alignedWords[0]?.start ?? beat.start;
                const paragraphEnd = alignedWords.at(-1)?.end ?? beat.end;
                const artworkSrc = artForBeat(beat.number);
                const mobileArtwork = mobileArtForBeat(beat.number) ?? artworkSrc;
                const artworkKind = artKindForBeat(beat.number);
                const isOriginalArtwork = artworkKind === "original";
                const isLiveArtwork = artworkKind === "live";
                return (
                  <article
                    class="story-beat has-featured-art"
                    id={`beat-${beat.number}`}
                    data-beat={beat.number}
                    data-start={beat.start}
                    data-end={beat.end}
                  >
                    <figure class="beat-visual">
                      <div
                        class={`beat-art-frame ${isOriginalArtwork ? "is-original-sketch" : ""} ${isLiveArtwork ? "is-live-sketch" : ""} ${artworkSrc ? "" : "is-missing-art"}`}
                        data-cinematic-art
                      >
                        <canvas
                          class="watercolor-wash"
                          data-watercolor-wash
                          data-watercolor-seed={beat.number}
                          data-watercolor-theme={chapterTheme(chapter.number)}
                          width="1"
                          height="1"
                          aria-hidden="true"
                        ></canvas>
                        <div
                          class="art-placeholder"
                          role="img"
                          aria-hidden={artworkSrc ? "true" : "false"}
                          aria-label={`${ui.drawing} ${beat.number} ${ui.drawingNeeded}: ${beat.prompt}`}
                        >
                          <span>{String(beat.number).padStart(2, "0")}</span>
                          <div class="placeholder-wind"><i></i><i></i><i></i></div>
                          <strong>{ui.drawingToCome}</strong>
                          <small>{beat.prompt}</small>
                        </div>
                        {artworkSrc && isLiveArtwork && (
                          <div
                            class="living-drawing"
                            data-live-drawing
                            data-mobile-animate
                            data-svg-src={artworkSrc}
                            data-raster-src={mobileArtwork}
                            role="img"
                            aria-label={`${ui.drawing} ${beat.number}: ${beat.prompt}`}
                          ></div>
                        )}
                        {artworkSrc && !isLiveArtwork && (
                          <picture>
                            <source media="(max-width: 760px)" srcset={mobileArtwork} />
                            <img
                              class={isOriginalArtwork ? "is-hand-sketch" : undefined}
                              src={artworkSrc}
                              alt={`${ui.drawing} ${beat.number}: ${beat.prompt}`}
                              data-story-art
                              loading={beat.number === 1 ? "eager" : "lazy"}
                              decoding="async"
                              fetchpriority={beat.number === 1 ? "high" : "low"}
                              width="1200"
                              height="800"
                            />
                          </picture>
                        )}
                      </div>
                    </figure>

                    <div class="beat-copy">
                      <p class="beat-number" aria-hidden="true">{String(beat.number).padStart(2, "0")}</p>
                      <p
                        class={beatIndex === 0 ? "opening-line" : undefined}
                        data-narration-paragraph
                        data-beat-number={beat.number}
                        data-start={paragraphStart}
                        data-end={paragraphEnd}
                      >
                        {words.map((word, wordIndex) => {
                          const cue = alignedWords[wordIndex];
                          const voice = resolvedVoice(chapter.number, word.speaker, cue?.speaker);
                          return (
                            <>
                              {wordIndex > 0 && " "}
                              <span
                                data-narration-word
                                data-voice-style={voice.style}
                                data-start={cue?.start ?? paragraphStart}
                                data-end={cue?.end ?? paragraphEnd}
                              >
                                {word.text}
                              </span>
                            </>
                          );
                        })}
                      </p>
                    </div>
                  </article>
                );
              })}
            </div>
          </section>
          );
        })}

        {endArtwork && (
          <div class="story-endmark" aria-hidden="true">
            {endArtwork.kind === "live" ? (
              <div
                class="living-drawing"
                data-live-drawing
                data-mobile-animate
                data-svg-src={endArtwork.src}
                data-raster-src={endArtwork.mobileSrc ?? endArtwork.src}
              ></div>
            ) : (
              <img
                src={endArtwork.mobileSrc ?? endArtwork.src}
                alt=""
                loading="lazy"
                decoding="async"
              />
            )}
          </div>
        )}

        {companion && (
          <section class="story-after" aria-labelledby="after-title">
            <p class="eyebrow">{companion.eyebrow}</p>
            <h2 id="after-title" class="visually-hidden">{companion.title}</h2>
            {companionTitleArtwork ? (
              <div class="story-after-title-art" aria-hidden="true">
                {companionTitleArtwork.kind === "live" ? (
                  <div
                    class="living-drawing"
                    data-live-drawing
                    data-mobile-animate
                    data-svg-src={companionTitleArtwork.src}
                    data-raster-src={companionTitleArtwork.mobileSrc ?? companionTitleArtwork.src}
                  ></div>
                ) : (
                  <img src={companionTitleArtwork.mobileSrc ?? companionTitleArtwork.src} alt="" />
                )}
              </div>
            ) : (
              <p class="story-after-title-fallback" aria-hidden="true">{companion.title}</p>
            )}
            <p>{companion.description}</p>
            <a class="primary-action light" href={companion.href}>{companion.actionLabel} <span aria-hidden="true">→</span></a>
            <a class="return-link" href="#top" data-reader-home>{ui.backToBeginning}</a>
          </section>
        )}
      </div>
    </div>
  </main>

  {narrationAvailable && (
  <div class="audio-dock is-compact" data-audio-dock>
    <audio
      data-audio
      preload="metadata"
      playsinline
    >
      {(windStoryReader.audio.sources ?? [{ src: windStoryReader.audio.src, type: "audio/mpeg" }]).map((source) => (
        <source src={source.src} type={source.type} />
      ))}
    </audio>
    <nav class="dock-chapters" aria-label="Story chapters">
      <ol>
        {chapters.map((chapter) => (
          <li>
            <a
              href={`#${chapter.id}`}
              data-dock-chapter-link
              data-chapter-index={chapter.number - 1}
              data-start={headingTimingByChapter.get(chapter.number)?.start ?? chapter.start}
              aria-label={`${ui.chapter} ${chapter.numeral}: ${chapter.title}`}
            >
              <span class="dock-chapter-progress" aria-hidden="true"></span>
              <strong>{chapter.numeral}</strong>
              <small>{chapter.shortTitle}</small>
            </a>
          </li>
        ))}
      </ol>
    </nav>
    <div class="dock-player">
      <button class="dock-play" type="button" data-play aria-label="Play narration">
        <span data-play-icon aria-hidden="true">▶</span>
      </button>
      <div class="dock-now">
        <small>Now in the story</small>
        <strong data-current-chapter>{ui.chapter} 1 · {windStoryReader.title}</strong>
      </div>
      <div class="dock-track">
        <div class="waveform" aria-hidden="true"></div>
        <input
          type="range"
          min="0"
          max={duration}
          value="0"
          step="0.1"
          data-seek
          aria-label="Narration position"
        />
        <div class="dock-time"><span data-current-time>0:00</span><span>{formatTime(duration)}</span></div>
      </div>
      <button class="dock-collapse" type="button" data-collapse aria-label="Expand story controls" aria-expanded="false">⌃</button>
    </div>
  </div>
  )}

  <nav class="reading-compass" data-reading-compass aria-label={ui.readingNavigation} aria-hidden="true">
    <button type="button" data-reader-previous aria-label={ui.previousChapter}>←</button>
    <a href="#top" data-reader-home>{ui.home}</a>
    <span data-reader-chapter-position>{ui.chapter} 1</span>
    <button type="button" data-reader-next aria-label={ui.nextChapter}>→</button>
  </nav>

  <script src="../scripts/story-player.ts"></script>
</Base>

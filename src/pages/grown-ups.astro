import "../styles/global.css";
import readingMarkdown from "../books/the-boy-who-tried-to-catch-the-wind/further-reading-for-grown-ups.md?raw";
---

<Base
  title="Further Reading for Grown-ups — Scale of Us"
  description="Books and essays related to The Boy Who Tried to Catch the Wind."
  bodyClass="grown-ups-page"
>
  <header class="grown-nav">
    <a class="wordmark dark" href="/" aria-label="Scale of Us, back to the story">
      <span>Scale</span><i>of</i><span>Us</span>
    </a>
    <a class="back-to-story" href="/">← Back to the story</a>
  </header>

  <main>
    <FurtherReadingContent markdown={readingMarkdown} />
  </main>
</Base>

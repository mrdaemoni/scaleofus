---
import Publisher from '../../../development/publisher-site-v10/src/layouts/Publisher.astro';
import checkout from '../../content/checkout.public.json';
import {windPublication} from '../../content/publication';
for(const url of [checkout.oneCopyUrl,checkout.twoCopyUrl]) {
  if(!/^https:\/\/buy\.stripe\.com\/[A-Za-z0-9]+$/.test(url))throw new Error('Checkout must use a verified hosted Stripe link.');
}
const options=[{quantity:1,url:checkout.oneCopyUrl},{quantity:2,url:checkout.twoCopyUrl}];
---
<Publisher title="A copy of your own — Scale of Us" description="Order a signed clothbound copy of The Boy Who Tried to Catch the Wind. US shipping is $12 per order." showContact={false}>
  <section class="wrap book-order">
    <div class="edition"><img src="/edition/cover.webp" alt="Blue clothbound book with gold title lettering" width="480" height="640"/><p class="eyebrow">SIGNED CLOTHBOUND HARDCOVER</p><h1>{windPublication.title}</h1><p>Written and illustrated by {windPublication.author}</p><p>English · 64 pages · 5½ × 8½ inches</p><a href="/stories/the-boy-who-tried-to-catch-the-wind/">← Back to the book</a></div>
    <div class="order-options"><h2>A copy of<br/><em>your own.</em></h2><p>Choose one or two signed copies.</p>
      {!checkout.enabled && <p class="opening-note" role="status">Orders are not open yet.</p>}
      <div class="copy-options">{options.map(({quantity,url})=><div class="copy-option"><h3>{quantity===1?'One signed copy':'Two signed copies'}</h3><p class="option-total">${checkout.priceUsd*quantity}</p><p class="option-breakdown">+ ${checkout.shippingUsd} US shipping<br/>Applicable sales tax at checkout</p>{checkout.enabled ? <a class="purchase-button" href={url}>Continue to checkout →</a> : <button class="purchase-button" type="button" disabled>Opening soon</button>}</div>)}</div>
      <p class="dispatch-note">US delivery only. Dispatch within five business days, with tracking sent after shipment. Up to two copies per order.</p><p class="support-links"><a href="/help/#delivery">Shipping details</a> · <a href="/help/#returns">Returns & damage</a> · <a href="/help/#contact">Contact</a></p>
    </div>
  </section>
</Publisher>
<style>
  .book-order{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.2fr);gap:70px;padding-block:50px 90px;align-items:start}.edition>img{width:170px;height:auto;mix-blend-mode:multiply}.edition h1{font-size:43px;line-height:1.1;margin-block:20px}.edition p{font-size:20px;line-height:1.5}.edition>a,.support-links a{color:inherit}.order-options>h2{font-size:54px;line-height:1.05;margin:0 0 24px}.order-options>p{font-size:22px;line-height:1.5}.copy-options{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-block:25px}.copy-option{padding:24px 20px;border:1px solid #dfcbd1;background:#fffdf8;min-width:0}.copy-option h3{font-size:25px;margin:0 0 15px}.option-total{font-size:46px;line-height:1.1;margin:0 0 12px}.option-breakdown{font-size:17px;line-height:1.4;min-height:46px}.copy-option .purchase-button{display:inline-block;font-size:18px;white-space:normal}.copy-option button:disabled{opacity:.6;cursor:default}.opening-note{border-left:3px solid #a07584;padding:12px 18px;background:#fffdf8}.dispatch-note,.support-links{font-size:18px!important}.support-links{margin-top:18px}@media(max-width:1000px){.book-order{gap:35px}.copy-options{grid-template-columns:1fr}.option-breakdown{min-height:0}}@media(max-width:700px){.book-order{grid-template-columns:1fr;padding-top:25px}.edition>img{float:right;width:100px;margin-left:16px}.edition h1{font-size:32px}.order-options>h2{font-size:43px}.copy-options{grid-template-columns:1fr 1fr}.copy-option{padding:18px 14px}.copy-option h3{font-size:22px}.copy-option .purchase-button{font-size:17px}.option-total{font-size:40px}.option-breakdown{min-height:48px}}@media(max-width:420px){.copy-options{grid-template-columns:1fr}.option-breakdown{min-height:0}}
</style>
